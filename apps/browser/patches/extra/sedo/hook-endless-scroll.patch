# Sends the start-page endless-scroll switch and limit to every renderer and
# compiles dark-patterns/endless-scroll/all-sites/ into the renderer. Applies
# after hook-short-form-video.patch. The prefs are sedo.endless_scroll_limiting
# and sedo.endless_scroll_limit; RendererUpdater pushes them as DynamicParams.
# When a Chromium update rejects a hunk, adjust the context lines here.
diff -ruN a/chrome/browser/chrome_content_browser_client.cc b/chrome/browser/chrome_content_browser_client.cc
--- a/chrome/browser/chrome_content_browser_client.cc
+++ b/chrome/browser/chrome_content_browser_client.cc
@@ -6087,7 +6087,9 @@
               policy::policy_prefs::kForceYouTubeRestrict),
           profile->GetPrefs()->GetString(prefs::kAllowedDomainsForApps),
           profile->GetPrefs()->GetBoolean(
-              sedo::prefs::kShortFormVideoBlocking));
+              sedo::prefs::kShortFormVideoBlocking),
+          profile->GetPrefs()->GetBoolean(sedo::prefs::kEndlessScrollLimiting),
+          profile->GetPrefs()->GetInteger(sedo::prefs::kEndlessScrollLimit));
   return std::make_unique<GoogleURLLoaderThrottle>(
 #if BUILDFLAG(IS_ANDROID)
       client_data_header,
diff -ruN a/chrome/browser/prefs/browser_prefs.cc b/chrome/browser/prefs/browser_prefs.cc
--- a/chrome/browser/prefs/browser_prefs.cc
+++ b/chrome/browser/prefs/browser_prefs.cc
@@ -1850,6 +1850,9 @@
                           const std::string& locale) {
   TRACE_EVENT0("browser", "chrome::RegisterProfilePrefs");
   registry->RegisterBooleanPref(sedo::prefs::kShortFormVideoBlocking, true);
+  registry->RegisterBooleanPref(sedo::prefs::kEndlessScrollLimiting, true);
+  registry->RegisterIntegerPref(sedo::prefs::kEndlessScrollLimit,
+                                sedo::prefs::kEndlessScrollDefaultLimit);
   // User prefs. Please keep this list alphabetized.
   AccessibilityLabelsService::RegisterProfilePrefs(registry);
   registry->RegisterBooleanPref(prefs::kRendererAccessibilityEnabled, true);
diff -ruN a/chrome/browser/profiles/renderer_updater.cc b/chrome/browser/profiles/renderer_updater.cc
--- a/chrome/browser/profiles/renderer_updater.cc
+++ b/chrome/browser/profiles/renderer_updater.cc
@@ -77,6 +77,9 @@
   allowed_domains_for_apps_.Init(prefs::kAllowedDomainsForApps, pref_service);
   sedo_short_form_video_.Init(sedo::prefs::kShortFormVideoBlocking,
                               pref_service);
+  sedo_endless_scroll_.Init(sedo::prefs::kEndlessScrollLimiting, pref_service);
+  sedo_endless_scroll_limit_.Init(sedo::prefs::kEndlessScrollLimit,
+                                  pref_service);
 
   pref_change_registrar_.Init(pref_service);
   pref_change_registrar_.Add(
@@ -95,6 +98,14 @@
       sedo::prefs::kShortFormVideoBlocking,
       base::BindRepeating(&RendererUpdater::UpdateAllRenderers,
                           base::Unretained(this)));
+  pref_change_registrar_.Add(
+      sedo::prefs::kEndlessScrollLimiting,
+      base::BindRepeating(&RendererUpdater::UpdateAllRenderers,
+                          base::Unretained(this)));
+  pref_change_registrar_.Add(
+      sedo::prefs::kEndlessScrollLimit,
+      base::BindRepeating(&RendererUpdater::UpdateAllRenderers,
+                          base::Unretained(this)));
 }
 
 RendererUpdater::~RendererUpdater() {
@@ -239,5 +250,6 @@
 #endif
       force_google_safesearch_.GetValue(), force_youtube_restrict_.GetValue(),
       allowed_domains_for_apps_.GetValue(),
-      sedo_short_form_video_.GetValue());
+      sedo_short_form_video_.GetValue(), sedo_endless_scroll_.GetValue(),
+      sedo_endless_scroll_limit_.GetValue());
 }
diff -ruN a/chrome/browser/profiles/renderer_updater.h b/chrome/browser/profiles/renderer_updater.h
--- a/chrome/browser/profiles/renderer_updater.h
+++ b/chrome/browser/profiles/renderer_updater.h
