@@ -30,6 +30,8 @@
   bool force_safe_search = true;
   int32 youtube_restrict = 0;
   string allowed_domains_for_apps;
+  // Sedo start-page switch. True runs the short-form video blocker.
+  bool sedo_short_form_video = true;
 };
 
