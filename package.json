  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "browser:download": "pnpm --filter @sedo/browser download",
    "browser:build": "pnpm --filter @sedo/browser build",
    "browser:open": "pnpm --filter @sedo/browser open",
    "browser:proof": "pnpm --filter @sedo/browser proof",
